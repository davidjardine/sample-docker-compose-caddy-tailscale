APP_NAME=immich

# The location where your uploaded files are stored
UPLOAD_LOCATION=./library

# The location where your database files are stored
DB_DATA_LOCATION=./postgres

# Optional, to set a timezone
# TZ=Etc/UTC

# The Immich version to use. ex: "v2" or "v2.1.0"
IMMICH_VERSION=v3

# Connection secret for postgres
# should be changed to a long random set of characters
# Please use only letters and numbers 
# no special characters or spaces
DB_PASSWORD=postgres

# The values below do not need to be changed
DB_USERNAME=postgres
DB_DATABASE_NAME=immich